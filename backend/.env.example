PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/leaf_detection
JWT_SECRET=replace-with-a-long-random-secret
AI_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
MAIL_MODE=local
# Local development emails are saved privately in backend/.local/mail.
# For production remove MAIL_MODE and configure RESEND_API_KEY + RESEND_FROM,
# BREVO_API_KEY + SMTP_FROM, or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS.
